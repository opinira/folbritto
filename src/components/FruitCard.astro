---
import type { Fruit } from '../types/fruit';

interface Props {
  fruit: Fruit;
  lazyLoad?: boolean;
}

const { fruit, lazyLoad = true } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const detailUrl = `${baseUrl}/fruits/${fruit.slug}/`;
const imageUrl = `${fruit.image}`;
---

<article
  class="fruit-card"
  data-slug={fruit.slug}
  data-name-bn={fruit.nameBn}
  data-name-en={fruit.nameEn.toLowerCase()}
  data-aliases={fruit.aliases.join(' ').toLowerCase()}
  data-seasons={fruit.seasonTags.join(',')}
  data-availabilities={fruit.availabilityTags.join(',')}
  data-groups={fruit.fruitGroupTags.join(',')}
>
  <a href={detailUrl} class="card-main-link" aria-label={`${fruit.nameBn} (${fruit.nameEn}) - বিস্তারিত তথ্য পড়ুন`}>
    <div class="card-image-wrap">
      <img
        src={imageUrl}
        alt={fruit.imageAltBn || `${fruit.nameBn} ফল`}
        width="360"
        height="360"
        loading={lazyLoad ? "lazy" : "eager"}
        decoding="async"
        class="card-img"
      />
      {!fruit.hasCustomPhoto && (
        <span class="placeholder-tag" aria-hidden="true">ছবি শীঘ্রই</span>
      )}
    </div>

    <div class="card-body">
      <div class="card-title-group">
        <h3 class="card-title-bn">{fruit.nameBn}</h3>
        <span class="card-title-en">{fruit.nameEn}</span>
      </div>

      <p class="card-intro">{fruit.introduction}</p>

      <div class="card-badges" aria-label="মৌসুম ও প্রাপ্যতা ট্যাগ">
        {fruit.seasonTags.slice(0, 2).map((s) => (
          <span class="badge badge-season">
            <span class="badge-dot" aria-hidden="true">●</span> {s}
          </span>
        ))}
        {fruit.availabilityTags.slice(0, 1).map((a) => (
          <span class={`badge ${a === 'আমদানিকৃত' ? 'badge-imported' : 'badge-availability'}`}>
            {a}
          </span>
        ))}
      </div>

      <div class="card-footer">
        <span class="card-cta">
          বিস্তারিত জানুন
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .fruit-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: var(--shadow-sm);
    position: relative;
  }

  .fruit-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: #B5CCA8;
  }

  .card-main-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  /* Exactly 1:1 square image container */
  .card-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #FFFDF5;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    object-position: center;
    background-color: #FFFDF5;
    padding: 0.5rem;
    transition: transform 0.3s ease;
  }

  .fruit-card:hover .card-img {
    transform: scale(1.03);
  }

  .placeholder-tag {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    background-color: rgba(32, 53, 42, 0.75);
    color: #FFFDF5;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title-group {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .card-title-bn {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-primary-green);
    line-height: 1.2;
  }

  .card-title-en {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .card-intro {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-primary-text);
    margin-bottom: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
    margin-bottom: 1rem;
  }

  .badge-dot {
    font-size: 0.6rem;
    color: var(--color-primary-green);
  }

  .card-footer {
    padding-top: 0.75rem;
    border-top: 1px dashed var(--color-border);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .card-cta {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary-green);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.15s ease;
  }

  .fruit-card:hover .card-cta {
    gap: 0.55rem;
    color: var(--color-primary-green-hover);
  }
</style>


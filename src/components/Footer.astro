---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentYear = '২০২৬';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Brand & Mission Column -->
      <div class="footer-col footer-about">
        <div class="footer-brand">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="34" height="34" fill="none" aria-hidden="true">
            <circle cx="24" cy="25" r="19" fill="#185C3A"/>
            <path d="M24 10C31.732 10 38 16.268 38 24C38 31.732 31.732 38 24 38C20.5 38 17.3 36.7 14.8 34.6C18.5 35 22.5 33.8 25.5 31C29.5 27.2 30.5 21.2 27.8 16.5C26.7 14.6 25 13.1 23 12.2C23.3 11.5 23.6 10.7 24 10Z" fill="#F6C453"/>
            <path d="M24 7C24 7 28 3 34 4C35 10 31 14 27 13.5C26 13.4 25.2 12.8 24.8 12L24 7Z" fill="#EDF5E8"/>
            <circle cx="21" cy="25" r="3.2" fill="#FFFDF5"/>
          </svg>
          <span class="footer-brand-name">ফলবৃত্ত</span>
        </div>
        <p class="footer-tagline">ফল চিনুন, জেনে খান।</p>
        <p class="footer-desc">
          বাংলাদেশে প্রাপ্ত স্থানীয় ও আমদানিকৃত ফলের নির্ভরযোগ্য বোটানিক্যাল পরিচয়, সঠিক পুষ্টিমান, মৌসুম এবং বিজ্ঞানসম্মত সতর্কতার সমন্বিত বাংলা ডিজিটাল তথ্যভান্ডার।
        </p>
      </div>

      <!-- Quick Directory Links -->
      <div class="footer-col">
        <h4 class="footer-heading">ডিরেক্টরি ও নেভিগেশন</h4>
        <ul class="footer-links">
          <li><a href={`${baseUrl}/#directory`}>সকল ৫০টি ফল</a></li>
          <li><a href={`${baseUrl}/#seasons`}>মৌসুম অনুযায়ী ফল</a></li>
          <li><a href={`${baseUrl}/about/`}>আমাদের সম্পর্কে</a></li>
          <li><a href={`${baseUrl}/sources/`}>তথ্যসূত্র ও সম্পাদকীয় পদ্ধতি</a></li>
          <li><a href={`${baseUrl}/disclaimer/`}>স্বাস্থ্য তথ্য সতর্কতা</a></li>
        </ul>
      </div>

      <!-- Reliable Sources Column -->
      <div class="footer-col">
        <h4 class="footer-heading">তথ্যসূত্র ও প্রতিষ্ঠান</h4>
        <ul class="footer-links">
          <li><a href="http://www.bari.gov.bd" target="_blank" rel="noopener noreferrer">বাংলাদেশ কৃষি গবেষণা ইনস্টিটিউট (BARI) ↗</a></li>
          <li><a href="https://fdc.nal.usda.gov" target="_blank" rel="noopener noreferrer">USDA FoodData Central ↗</a></li>
          <li><a href="https://www.fao.org/infoods" target="_blank" rel="noopener noreferrer">FAO INFOODS ↗</a></li>
          <li><a href="http://www.ais.gov.bd" target="_blank" rel="noopener noreferrer">কৃষি তথ্য সার্ভিস (AIS) ↗</a></li>
        </ul>
      </div>
    </div>

    <!-- Educational Disclaimer Box -->
    <div class="footer-disclaimer-card">
      <div class="disclaimer-header">
        <span class="disclaimer-icon" aria-hidden="true">ℹ️</span>
        <span class="disclaimer-title">সাধারণ সচেতনতামূলক বার্তা</span>
      </div>
      <p class="disclaimer-text">
        'ফলবৃত্ত'-এ প্রকাশিত সকল স্বাস্থ্য ও পুষ্টিতথ্য কেবল সাধারণ শিক্ষামূলক ও তথ্যজ্ঞাপনের উদ্দেশ্যে পরিবেশিত। কোনো তথ্যই চিকিৎসকের পেশাদার ব্যবস্থাপত্র বা পথ্যনির্দেশনার বিকল্প নয়। বিশেষ শারীরিক অবস্থা, দীর্ঘমেয়াদি রোগ বা ওষুধের সঙ্গে নির্দিষ্ট ফলের প্রতিক্রিয়া সম্পর্কে জানতে সর্বদা রেজিস্টার্ড চিকিৎসকের পরামর্শ নিন। প্রদর্শিত চিত্রসমূহ শনাক্তকরণ ও অলংকরণের উদ্দেশ্যে উপস্থাপিত।
      </p>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="footer-bottom">
      <p>© {currentYear} ফলবৃত্ত (Folbritto)। সর্বস্বত্ব সংরক্ষিত।</p>
      <p class="footer-license-note">তথ্যসূত্রভিত্তিক ও অবাণিজ্যিক জনকল্যাণমুখী উন্মুক্ত জ্ঞানকোষ।</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #F8F6EB;
    border-top: 1px solid var(--color-border);
    padding-top: 3.5rem;
    padding-bottom: 2rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 3.5rem;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.5rem;
  }

  .footer-brand-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary-green);
  }

  .footer-tagline {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .footer-desc {
    font-size: 0.9375rem;
    color: var(--color-primary-text);
    line-height: 1.6;
    max-width: 440px;
  }

  .footer-heading {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-primary-green);
    margin-bottom: 1.25rem;
    position: relative;
    padding-bottom: 0.5rem;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background-color: var(--color-accent-yellow);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.9375rem;
    color: var(--color-primary-text);
    transition: color 0.15s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--color-primary-green);
    text-decoration: underline;
  }

  /* Educational Disclaimer Box */
  .footer-disclaimer-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .disclaimer-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .disclaimer-icon {
    font-size: 1.1rem;
  }

  .disclaimer-title {
    font-weight: 700;
    color: var(--color-primary-green);
    font-size: 0.9375rem;
  }

  .disclaimer-text {
    font-size: 0.84375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1.5rem;
    border-top: 1px solid #E6DDC4;
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer-license-note {
    font-size: 0.8125rem;
    margin-bottom: 0;
  }
</style>


---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <div class="container header-container">
    <a href={`${baseUrl}/`} class="brand-link" aria-label="ফলবৃত্ত হোমপেজ">
      <div class="brand-logo-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="38" height="38" fill="none" aria-hidden="true">
          <circle cx="24" cy="25" r="19" fill="#185C3A"/>
          <path d="M24 10C31.732 10 38 16.268 38 24C38 31.732 31.732 38 24 38C20.5 38 17.3 36.7 14.8 34.6C18.5 35 22.5 33.8 25.5 31C29.5 27.2 30.5 21.2 27.8 16.5C26.7 14.6 25 13.1 23 12.2C23.3 11.5 23.6 10.7 24 10Z" fill="#F6C453"/>
          <path d="M24 7C24 7 28 3 34 4C35 10 31 14 27 13.5C26 13.4 25.2 12.8 24.8 12L24 7Z" fill="#EDF5E8"/>
          <path d="M24 7C25 10 27 12 30 11.5" stroke="#185C3A" stroke-width="1.2" stroke-linecap="round"/>
          <circle cx="21" cy="25" r="3.2" fill="#FFFDF5"/>
        </svg>
      </div>
      <div class="brand-text">
        <span class="brand-name">ফলবৃত্ত</span>
        <span class="brand-tagline">ফল চিনুন, জেনে খান।</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-desktop" aria-label="প্রধান নেভিগেশন">
      <ul class="nav-list">
        <li><a href={`${baseUrl}/#directory`} class="nav-link">সকল ফল</a></li>
        <li><a href={`${baseUrl}/#seasons`} class="nav-link">মৌসুম অনুযায়ী</a></li>
        <li><a href={`${baseUrl}/about/`} class="nav-link">আমাদের সম্পর্কে</a></li>
        <li><a href={`${baseUrl}/sources/`} class="nav-link">তথ্যসূত্র</a></li>
      </ul>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-btn"
      class="mobile-menu-btn"
      type="button"
      aria-label="মেনু খুলুন"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div id="mobile-nav" class="mobile-nav" aria-hidden="true">
    <div class="mobile-nav-inner">
      <div class="mobile-nav-header">
        <span class="mobile-brand-title">ফলবৃত্ত নেভিগেশন</span>
        <button id="mobile-close-btn" class="mobile-close-btn" type="button" aria-label="মেনু বন্ধ করুন">
          ✕
        </button>
      </div>
      <ul class="mobile-nav-list">
        <li><a href={`${baseUrl}/#directory`} class="mobile-nav-link">সকল ফল ডিরেক্টরি</a></li>
        <li><a href={`${baseUrl}/#seasons`} class="mobile-nav-link">মৌসুম অনুযায়ী ফল</a></li>
        <li><a href={`${baseUrl}/about/`} class="mobile-nav-link">আমাদের সম্পর্কে</a></li>
        <li><a href={`${baseUrl}/sources/`} class="mobile-nav-link">তথ্যসূত্র ও সম্পাদকীয় পদ্ধতি</a></li>
        <li><a href={`${baseUrl}/disclaimer/`} class="mobile-nav-link">স্বাস্থ্য তথ্য সতর্কতা</a></li>
      </ul>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const mobileNav = document.getElementById('mobile-nav');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function openMenu() {
    if (!mobileNav || !menuBtn) return;
    mobileNav.classList.add('is-open');
    mobileNav.setAttribute('aria-hidden', 'false');
    menuBtn.setAttribute('aria-expanded', 'true');
    menuBtn.setAttribute('aria-label', 'মেনু বন্ধ করুন');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    if (!mobileNav || !menuBtn) return;
    mobileNav.classList.remove('is-open');
    mobileNav.setAttribute('aria-hidden', 'true');
    menuBtn.setAttribute('aria-expanded', 'false');
    menuBtn.setAttribute('aria-label', 'মেনু খুলুন');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.contains('is-open');
    if (isOpen) closeMenu();
    else openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileNav?.classList.contains('is-open')) {
      closeMenu();
      menuBtn?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 253, 245, 0.95);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0;
  }

  .brand-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary-green);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .brand-tagline {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-muted);
    line-height: 1.2;
  }

  .nav-desktop {
    display: none;
  }

  @media (min-width: 820px) {
    .nav-desktop {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
  }

  .nav-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary-text);
    padding: 0.5rem 0.25rem;
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-primary-green);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-primary-green);
    transition: width 0.2s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background-color: var(--color-white);
  }

  @media (min-width: 820px) {
    .mobile-menu-btn {
      display: none;
    }
  }

  .hamburger-bar {
    width: 20px;
    height: 2px;
    background-color: var(--color-primary-text);
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  /* Mobile Drawer */
  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(32, 53, 42, 0.45);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .mobile-nav.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-inner {
    position: absolute;
    top: 0;
    right: 0;
    width: 80%;
    max-width: 320px;
    height: 100%;
    background-color: var(--color-bg);
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.25s ease-in-out;
  }

  .mobile-nav.is-open .mobile-nav-inner {
    transform: translateX(0);
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-brand-title {
    font-weight: 700;
    color: var(--color-primary-green);
    font-size: 1.125rem;
  }

  .mobile-close-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    color: var(--color-primary-text);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background-color: var(--color-white);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary-text);
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease;
  }

  .mobile-nav-link:hover {
    background-color: var(--color-soft-green);
    color: var(--color-primary-green);
  }
</style>


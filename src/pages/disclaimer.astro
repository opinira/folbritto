---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'স্বাস্থ্য তথ্য বিষয়ক সতর্কতা ও দায়মুক্তি | ফলবৃত্ত';
const description = 'ফলবৃত্ত ওয়েবসাইটের স্বাস্থ্য ও পুষ্টিতথ্য ব্যবহারের সাধারণ শর্তাবলী, মেডিকেল সতর্কতা এবং শিক্ষামূলক দায়মুক্তি পত্র।';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={title} description={description} canonicalPath="/disclaimer/">
  <div class="container article-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs" aria-label="ব্রেডক্রাম্ব নেভিগেশন">
      <ol class="breadcrumb-list">
        <li><a href={`${baseUrl}/`}>হোম</a></li>
        <li class="breadcrumb-separator" aria-hidden="true">›</li>
        <li class="breadcrumb-current" aria-current="page">স্বাস্থ্য তথ্য সতর্কতা</li>
      </ol>
    </nav>

    <article class="article-body">
      <header class="article-header">
        <span class="article-eyebrow">মেডিকেল ও পুষ্টি সম্পর্কিত বিজ্ঞপ্তি</span>
        <h1 class="article-title">স্বাস্থ্য তথ্য বিষয়ক সতর্কতা ও দায়মুক্তি</h1>
        <p class="article-lead">
          'ফলবৃত্ত' (Folbritto)-তে প্রকাশিত যাবতীয় তথ্য ও পরামর্শ কেবল সাধারণ শিক্ষামূলক, বোটানিক্যাল পরিচিতি ও জনসচেতনতার উদ্দেশ্যে প্রস্তুত করা হয়েছে।
        </p>
      </header>

      <section class="editorial-section">
        <div class="caution-box">
          <h4>চিকিৎসকের পরামর্শের কোনো বিকল্প নয়</h4>
          <p>
            এই ওয়েবসাইটের কোনো তথ্যই কোনো পেশাদার রেজিস্টার্ড চিকিৎসক বা পুষ্টিবিদের সরাসরি রোগনির্ণয়, চিকিৎসা পরিকল্পনা বা পথ্যনির্দেশনার বিকল্প হিসেবে বিবেচনা করা যাবে না। আপনার কোনো দীর্ঘমেয়াদি শারীরিক অসুস্থতা থাকলে বা নতুন কোনো খাদ্যরীতি শুরু করার আগে সর্বদা আপনার চিকিৎসকের সাথে পরামর্শ করুন।
          </p>
        </div>

        <h2>গুরুত্বপূর্ণ স্বাস্থ্য ও ক্লিনিক্যাল নির্দেশনাসমূহ</h2>

        <div class="disclaimer-points-list">
          <!-- Point 1 -->
          <div class="disclaimer-point-card">
            <h3>১. ক্রনিক কিডনি ডিজিজ (CKD) ও কামরাঙা সতর্কতা</h3>
            <p>
              কিডনি অকার্যকারিতা বা ডায়ালাইসিসে থাকা রোগীদের ক্ষেত্রে <strong>কামরাঙা (Star fruit)</strong> খাওয়া সম্পূর্ণ প্রাণঘাতী হতে পারে। কামরাঙায় থাকা 'ক্যারামবক্সিন' (Caramboxin) নিউরোটক্সিন দুর্বল কিডনি শরীর থেকে ছেঁকে বের করতে পারে না, যা মস্তিষ্কে মারাত্মক খিঁচুনি, বিষক্রিয়া এমনকি মৃত্যুর কারণ হতে পারে। এছাড়াও উচ্চ পটাসিয়ামযুক্ত ফল (যেমন কলা, ডাবের পানি, শুকনো খেজুর) কিডনি রোগীদের রক্তে পটাসিয়ামের মাত্রা বিপজ্জনকভাবে বাড়িয়ে দিতে পারে।
            </p>
          </div>

          <!-- Point 2 -->
          <div class="disclaimer-point-card">
            <h3>২. ডায়াবেটিস ও রক্তে শর্করা ব্যবস্থাপনা</h3>
            <p>
              সব ফল সব ডায়াবেটিস রোগীর জন্য সমপরিমাণে নিরাপদ নয়। পাকা আম, পাকা কাঁঠাল, আতা, পাকা কলা কিংবা শুকনো খেজুরে ফ্রুক্টোজ ও শর্করার ঘনত্ব অনেক বেশি থাকে। ডায়াবেটিস রোগীরা এসব ফল সম্পূর্ণ বর্জন না করলেও অবশ্যই চিকিৎসকের প্রেসক্রিপশন অনুযায়ী দৈনিক কার্বোহাইড্রেটের হিসাবের মধ্যে সীমিত পরিমাণে গ্রহণ করবেন।
            </p>
          </div>

          <!-- Point 3 -->
          <div class="disclaimer-point-card">
            <h3>৩. গর্ভাবস্থা ও কাঁচা পেঁপে পরিহার</h3>
            <p>
              কাঁচা ও আধপাকা পেঁপেতে উচ্চমাত্রার প্রাকৃতিক ল্যাটেক্স ও প্যাপাইন থাকে, যা গর্ভাশয়ের অনৈচ্ছিক পেশির সংকোচন ঘটিয়ে গর্ভপাতের ঝুঁকি তৈরি করতে পারে। তাই গর্ভবতী মায়েদের ক্ষেত্রে কাঁচা বা আধা-পাকা পেঁপে খাওয়া সম্পূর্ণ অনুচিত।
            </p>
          </div>

          <!-- Point 4 -->
          <div class="disclaimer-point-card">
            <h3>৪. ওষুধের সাথে ফলের মিথস্ক্রিয়া (Drug Interactions)</h3>
            <p>
              কিছু সাইট্রাস ফল (যেমন জাম্বুরা বা জামির) লিভারের সাইটোক্রোম P450 3A4 এনজাইমকে সাময়িকভাবে নিষ্ক্রিয় করতে পারে। এর ফলে কোলেস্টেরল কমানোর স্ট্যাটিন, নির্দিষ্ট উচ্চ রক্তচাপের ওষুধ বা রক্ত পাতলাকারী ওষুধের ঘনত্ব রক্তে অস্বাভাবিক বেড়ে যেতে পারে। আপনি যদি নিয়মিত কোনো প্রেসক্রিপশন ওষুধ সেবন করেন, তবে বড় আকারের সাইট্রাস ফল নিয়মিত খাওয়ার আগে চিকিৎসকের সাথে কথা বলুন।
            </p>
          </div>

          <!-- Point 5 -->
          <div class="disclaimer-point-card">
            <h3>৫. ল্যাটেক্স-ফ্রুট সিন্ড্রোম (Latex-Fruit Syndrome)</h3>
            <p>
              যাদের রাবার বা ল্যাটেক্সের প্রতি অ্যালার্জি রয়েছে, তাদের ক্ষেত্রে অ্যাভোকাডো, কলা, কিউই এবং প্যাশন ফ্রুটের মতো ফলে ক্রস-রিঅ্যাকটিভ অ্যালার্জি দেখা দিতে পারে। মুখ বা গলায় চুলকানি, আমবাত বা শ্বাসকষ্টের মতো কোনো উপসর্গ দেখা দিলে অবিলম্বে ফলটি খাওয়া বন্ধ করুন ও চিকিৎসা নিন।
            </p>
          </div>
        </div>
      </section>

      <section class="editorial-section">
        <h2>চিত্র ও অলংকরণ সম্পর্কিত বিজ্ঞপ্তি</h2>
        <p>
          ফলবৃত্তে ব্যবহৃত ফলসমূহের আলোকচিত্রগুলো ফলের সাধারণ প্রজাতি শনাক্তকরণ ও শিক্ষামূলক অলংকরণের উদ্দেশ্যে পরিবেশন করা হয়েছে। প্রাকৃতিক ফলনের বৈচিত্র্য, জলবায়ু, চাষের অঞ্চল এবং কৃষিভেদে বাস্তব ফলের আকার, বর্ণ ও খোসার মসৃণতায় কিছুটা ভিন্নতা থাকা স্বাভাবিক। কোনো ফলের জন্য নতুন আলোকচিত্র যুক্ত হওয়ার আগ পর্যন্ত সাময়িকভাবে মার্জিত প্লেসহোল্ডার চিত্র প্রদর্শিত হয়।
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .article-container {
    padding-top: 2rem;
    padding-bottom: 5rem;
    max-width: 860px;
  }

  .breadcrumbs {
    margin-bottom: 2rem;
  }

  .breadcrumb-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .breadcrumb-list a {
    color: var(--color-primary-green);
    font-weight: 600;
  }

  .breadcrumb-separator {
    color: #9EAF9B;
  }

  .breadcrumb-current {
    font-weight: 700;
    color: var(--color-primary-text);
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-eyebrow {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    background-color: var(--color-soft-green);
    color: var(--color-primary-green);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary-green);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .article-lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-primary-text);
    font-weight: 500;
  }

  .editorial-section {
    margin-bottom: 3rem;
  }

  .editorial-section h2 {
    font-size: 1.5rem;
    color: var(--color-primary-green);
    margin-bottom: 1.25rem;
    margin-top: 2rem;
  }

  .editorial-section p {
    font-size: 1.0625rem;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .disclaimer-points-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .disclaimer-point-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-left: 4px solid #C43B08;
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .disclaimer-point-card h3 {
    font-size: 1.15rem;
    color: #B53607;
    margin-bottom: 0.5rem;
  }

  .disclaimer-point-card p {
    font-size: 0.96875rem;
    line-height: 1.65;
    color: var(--color-primary-text);
    margin-bottom: 0;
  }
</style>


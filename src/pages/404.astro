---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'পৃষ্ঠাটি খুঁজে পাওয়া যায়নি (৪০৪) | ফলবৃত্ত';
const description = 'অনুরোধকৃত ফলের পাতাটি খুঁজে পাওয়া যায়নি। ফলবৃত্তের মূল ডিরেক্টরিতে ফিরে যান।';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={title} description={description}>
  <div class="container not-found-container">
    <div class="not-found-card">
      <div class="not-found-icon" aria-hidden="true">🍃</div>
      <span class="error-code">৪০৪</span>
      <h1 class="not-found-title">পৃষ্ঠাটি খুঁজে পাওয়া যায়নি</h1>
      <p class="not-found-desc">
        আপনি যে ফলের পাতা বা ঠিকানায় প্রবেশের চেষ্টা করছেন, তা হয়তো স্থানান্তরিত হয়েছে অথবা লিংকটিতে কোনো ত্রুটি রয়েছে।
      </p>
      <div class="not-found-actions">
        <a href={`${baseUrl}/`} class="btn btn-primary">
          হোমপেজে ফিরে যান
        </a>
        <a href={`${baseUrl}/#directory`} class="btn btn-secondary">
          সকল ফলের তালিকা দেখুন
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-container {
    padding-top: 4rem;
    padding-bottom: 6rem;
    display: flex;
    justify-content: center;
  }

  .not-found-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 3rem 2rem;
    text-align: center;
    max-width: 520px;
    box-shadow: var(--shadow-sm);
  }

  .not-found-icon {
    font-size: 3.5rem;
    margin-bottom: 0.5rem;
  }

  .error-code {
    display: inline-block;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-primary-green);
    background-color: var(--color-soft-green);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .not-found-title {
    font-size: 1.875rem;
    color: var(--color-primary-green);
    margin-bottom: 0.75rem;
  }

  .not-found-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>

